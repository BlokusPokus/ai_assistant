# Development Environment Variables (optional)
# Used by docker-compose.dev.yml for substitution (Redis password, DB user, Grafana admin).
#
# Option A – One config file (recommended): add these vars to config/development.env
# (same file as DATABASE_URL, CELERY_BROKER_URL, etc.) and run:
#   docker compose -f docker/docker-compose.dev.yml --env-file config/development.env up -d
# Then DEV_REDIS_PASSWORD and DB credentials stay in sync with your app config.
#
# Option B – Separate file: copy this to docker/.env and set values. Do not commit .env.
#
# If unset, compose uses: postgres / password / redis_password / admin

# Database (when using host Postgres from Docker)
DEV_DB_USER=postgres
DEV_DB_PASSWORD=password

# Redis (must match the password used in REDIS_URL / CELERY_BROKER_URL in development.env)
DEV_REDIS_PASSWORD=redis_password

# Grafana admin UI
DEV_GRAFANA_ADMIN_PASSWORD=admin
